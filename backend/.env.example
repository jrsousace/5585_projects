PORT=3000

# Origens web autorizadas para chamadas à API (separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://5585projects.com.br
PUBLIC_APP_URL=https://5585projects.com.br

# Gere uma chave exclusiva com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes

# Configurações do Banco de Dados PostgreSQL (Homologação)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=saas_financeiro_homolog

# SMTP credentials: configure in Secret Manager, never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Local HTTP development only. Set true in production (or leave unset).
COOKIE_SECURE=false

# Stripe routes are not mounted; billing integration is deferred.
