{
  "name": "saas-financeiro-backend",
  "version": "1.0.0",
  "description": "Backend API para o SaaS Financeiro",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:tenant": "node src/database/migrateTenant.js",
    "migrate:registration-profile": "node src/database/migrateRegistrationProfile.js",
    "migrate:subscription": "node src/database/migrateSubscription.js",
    "migrate:account-security": "node src/database/migrateAccountSecurity.js",
    "promote:master": "node src/database/promoteMasterAccount.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.5.0",
    "pg": "^8.11.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.8"
    }
